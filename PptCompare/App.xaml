<Application x:Class="PptCompare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBrush" Color="#F4F6F9" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#D9DEE7" />
        <SolidColorBrush x:Key="InkBrush" Color="#172033" />
        <SolidColorBrush x:Key="MutedBrush" Color="#697386" />
        <SolidColorBrush x:Key="HeaderBrush" Color="#2C4697" />
        <SolidColorBrush x:Key="CompareBrush" Color="#2CA02C" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E8F0FF" />
        <SolidColorBrush x:Key="AddedBrush" Color="#15803D" />
        <SolidColorBrush x:Key="RemovedBrush" Color="#C2413B" />
        <SolidColorBrush x:Key="ChangedBrush" Color="#C77B16" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource CompareBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource CompareBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
    </Application.Resources>
</Application>
