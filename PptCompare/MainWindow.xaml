<Window x:Class="PptCompare.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:PptCompare.Controls"
        xmlns:models="clr-namespace:PptCompare.Models"
        Title="PptCompare"
        Width="1440"
        Height="900"
        MinWidth="1080"
        MinHeight="680"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI"
        Foreground="{StaticResource InkBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="PreviewLoadingOverlayStyle" TargetType="ContentControl">
            <Setter Property="Content" Value="Rendering" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Border Background="#E8FFFFFF">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar Width="220" Height="7"
                                             IsIndeterminate="True"
                                             Foreground="{TemplateBinding Foreground}" />
                                <TextBlock Text="Generating high-fidelity preview…"
                                           Margin="0,15,0,0"
                                           HorizontalAlignment="Center"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource InkBrush}" />
                                <TextBlock Text="PowerPoint is working in the background"
                                           Margin="0,5,0,0"
                                           HorizontalAlignment="Center"
                                           FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBrush}" Padding="20,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/PptCompareIcon.png" Width="34" Height="34"
                           Stretch="Uniform" Margin="0,0,12,0"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel>
                        <TextBlock Text="PptCompare" Foreground="White" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Presentation version review" Foreground="#DCE5FF" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="About" Command="{Binding AboutCommand}"
                            Margin="0,0,10,0" Padding="14,8" Background="#243B82"
                            BorderBrush="#7087CD" Foreground="White" />
                    <Button Content="Settings" Command="{Binding SettingsCommand}"
                            Margin="0,0,10,0" Padding="14,8" Background="#243B82"
                            BorderBrush="#7087CD" Foreground="White" />
                    <Button Content="Compare" Style="{StaticResource PrimaryButton}" Command="{Binding CompareCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#EEF1F5" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Local comparison • .pptx and .pptm • PowerPoint optional" Foreground="{StaticResource MutedBrush}" />
            </StatusBarItem>
        </StatusBar>

        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" MinHeight="144" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="5" CornerRadius="3" Background="#3B82F6" Margin="0,2,12,2" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="LEFT VERSION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding LeftVersions}" SelectedItem="{Binding SelectedLeftVersion}"
                                              DisplayMemberPath="DisplayName" MinWidth="280" />
                                    <TextBlock Text="Select a presentation…"
                                               Margin="12,0,32,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedLeftVersion}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Command="{Binding OpenPresentationCommand}" CommandParameter="Left" />
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Button Grid.Column="1"
                            Content="⇄"
                            Command="{Binding SwapSidesCommand}"
                            ToolTip="Switch left and right presentations"
                            AutomationProperties.Name="Switch left and right presentations"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource AccentBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="3"
                            Margin="2,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="5" CornerRadius="3" Background="#A855F7" Margin="0,2,12,2" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="RIGHT VERSION" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                            <Grid Margin="0,5,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <ComboBox ItemsSource="{Binding RightVersions}" SelectedItem="{Binding SelectedRightVersion}"
                                              DisplayMemberPath="DisplayName" MinWidth="280" />
                                    <TextBlock Text="Select a presentation…"
                                               Margin="12,0,32,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource MutedBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedRightVersion}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse…" Command="{Binding OpenPresentationCommand}" CommandParameter="Right" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid>
                                <TextBlock Text="Slides" FontWeight="SemiBold" FontSize="14" />
                                <Border HorizontalAlignment="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding Slides.Count}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                        <ListBox ItemsSource="{Binding Slides}" SelectedItem="{Binding SelectedSlide}" BorderThickness="0"
                                 Background="Transparent" Padding="7" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:SlideComparisonItem}">
                                    <Grid Margin="3,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,5,0,0" />
                                        <Border Grid.Column="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4"
                                                Background="White" Padding="9" MinHeight="62">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding ChangeColor}" Margin="0,0,6,0" />
                                                    <TextBlock Text="{Binding ChangeKind}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding LeftPaneHeading}" FontWeight="SemiBold" />
                        </Border>
                        <ScrollViewer x:Name="LeftPane" ScrollChanged="ComparisonPane_OnScrollChanged"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel Width="720">
                                <Border Background="#FCFCFD" BorderBrush="#BFC7D4" BorderThickness="1" Height="405">
                                    <Grid>
                                        <controls:SlidePreviewControl
                                            Slide="{Binding SelectedSlide.LeftSlide}"
                                            Changes="{Binding SelectedSlide.ElementChanges}" />
                                        <ContentControl
                                            Style="{StaticResource PreviewLoadingOverlayStyle}"
                                            Foreground="#F06455"
                                            Visibility="{Binding IsLeftPreviewRendering, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="Left preview rendering" />
                                    </Grid>
                                </Border>
                                <Border Background="#FCFCFD" BorderBrush="#BFC7D4" BorderThickness="1"
                                        Padding="30,26" Margin="0,12,0,0">
                                    <StackPanel>
                                        <controls:DiffTextBlock PlainText="{Binding SelectedSlide.LeftTitle}"
                                                                Segments="{Binding SelectedSlide.LeftTitleSegments}"
                                                                RichContent="{Binding SelectedSlide.LeftTitleContent}"
                                                                FontSize="{Binding OutputTextFontSize}" />
                                        <Border Height="4" Width="72" Background="#3B82F6" HorizontalAlignment="Left" Margin="0,18,0,26" />
                                        <controls:DiffTextBlock PlainText="{Binding SelectedSlide.LeftBody}"
                                                                Segments="{Binding SelectedSlide.LeftBodySegments}"
                                                                RichContent="{Binding SelectedSlide.LeftBodyContent}"
                                                                FontSize="{Binding OutputTextFontSize}" />
                                        <Border Background="#FDECEC" BorderBrush="#F5B5B0" BorderThickness="1" Padding="12" Margin="0,30,0,0">
                                            <TextBox Text="{Binding SelectedSlide.LeftCallout}" Foreground="#A7332C"
                                                     IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     FontSize="{Binding OutputTextFontSize}"
                                                     Background="Transparent" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Left slide preview with detected visual changes"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" Padding="14,10" Background="#F8FAFC" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="{Binding RightPaneHeading}" FontWeight="SemiBold" />
                        </Border>
                        <ScrollViewer x:Name="RightPane" ScrollChanged="ComparisonPane_OnScrollChanged"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Padding="20">
                            <StackPanel Width="720">
                                <Border Background="#FCFCFD" BorderBrush="#BFC7D4" BorderThickness="1" Height="405">
                                    <Grid>
                                        <controls:SlidePreviewControl
                                            Slide="{Binding SelectedSlide.RightSlide}"
                                            Changes="{Binding SelectedSlide.ElementChanges}"
                                            IsRightSide="True" />
                                        <ContentControl
                                            Style="{StaticResource PreviewLoadingOverlayStyle}"
                                            Foreground="{StaticResource CompareBrush}"
                                            Visibility="{Binding IsRightPreviewRendering, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            AutomationProperties.Name="Right preview rendering" />
                                    </Grid>
                                </Border>
                                <Border Background="#FCFCFD" BorderBrush="#BFC7D4" BorderThickness="1"
                                        Padding="30,26" Margin="0,12,0,0">
                                    <StackPanel>
                                        <controls:DiffTextBlock PlainText="{Binding SelectedSlide.RightTitle}"
                                                                Segments="{Binding SelectedSlide.RightTitleSegments}"
                                                                RichContent="{Binding SelectedSlide.RightTitleContent}"
                                                                FontSize="{Binding OutputTextFontSize}" />
                                        <Border Height="4" Width="72" Background="#A855F7" HorizontalAlignment="Left" Margin="0,18,0,26" />
                                        <controls:DiffTextBlock PlainText="{Binding SelectedSlide.RightBody}"
                                                                Segments="{Binding SelectedSlide.RightBodySegments}"
                                                                RichContent="{Binding SelectedSlide.RightBodyContent}"
                                                                FontSize="{Binding OutputTextFontSize}" />
                                        <Border Background="#EAF7EE" BorderBrush="#A9DCB7" BorderThickness="1" Padding="12" Margin="0,30,0,0">
                                            <TextBox Text="{Binding SelectedSlide.RightCallout}" Foreground="#146B32"
                                                     IsReadOnly="True" BorderThickness="0" Padding="0"
                                                     FontSize="{Binding OutputTextFontSize}"
                                                     Background="Transparent" TextWrapping="Wrap" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Right slide preview with detected visual changes"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,9,0,0" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </Grid>

            <Border Grid.Row="4" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="1" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Change summary" FontSize="14" FontWeight="SemiBold" />
                        <WrapPanel Margin="0,16,0,0">
                            <Border Background="#FFF3E0" CornerRadius="6" Padding="10,7" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="{StaticResource ChangedBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding ChangedCountText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="#EAF7EE" CornerRadius="6" Padding="10,7" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="{StaticResource AddedBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding AddedCountText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="#FDECEC" CornerRadius="6" Padding="10,7" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="{StaticResource RemovedBrush}" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding RemovedCountText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                            <Border Background="#E8F0FE" CornerRadius="6" Padding="10,7" Margin="0,0,6,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="●" Foreground="#2563EB" Margin="0,0,6,0" />
                                    <TextBlock Text="{Binding MovedCountText}" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Background="{StaticResource BorderBrush}" Margin="0,0,18,0" />
                    <StackPanel Grid.Column="2" Margin="18,0,0,0">
                        <TextBlock Text="Selected change" FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding SelectedSlide.ChangeSummary}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,5" />
                        <TextBlock Text="Select a slide to review its detected text, layout, and visual changes. Detailed element-level results will appear here."
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
